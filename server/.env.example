NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://supportdesk:supportdesk@localhost:5432/supportdesk?schema=public

# Comma-separated list of allowed browser origins (CORS allow-list)
CORS_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# Mail: leave SMTP_HOST empty in dev to log emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SupportDesk <no-reply@supportdesk.local>"

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Feature flags
FEATURE_DOMAIN_AUTOJOIN=false

# Background jobs (SLA breach check every minute, auto-close hourly)
JOBS_ENABLED=true

# Largest ticket CSV export in one request
EXPORT_MAX_ROWS=20000
