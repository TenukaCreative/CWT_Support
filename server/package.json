{
  "name": "@supportdesk/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "docs:openapi": "node --env-file=.env scripts/generate-openapi.js",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "globalSetup": "./tests/global-setup.js",
    "setupFiles": [
      "./tests/setup-env.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageProvider": "v8",
    "coverageReporters": [
      "text-summary",
      "text"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 96,
        "lines": 96,
        "functions": 94,
        "branches": 88
      }
    }
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.4.17",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsdom": "^25.0.1",
    "jsonwebtoken": "^9.0.2",
    "marked": "^12.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.7",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "prisma": "^6.1.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0"
  }
}
