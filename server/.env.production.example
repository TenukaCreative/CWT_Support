# Production configuration. Copy, fill in, and supply to the container (NEVER commit real values).
NODE_ENV=production
PORT=4000

# --- required ---------------------------------------------------------------------------------
DATABASE_URL=postgresql://supportdesk:CHANGE_ME@db:5432/supportdesk?schema=public
# https:// is REQUIRED in production (the refresh cookie is Secure and same-site).
CLIENT_URL=https://support.example.com
CORS_ORIGINS=https://support.example.com
# Two DIFFERENT random secrets, 32+ characters:  openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- email (without SMTP_HOST nobody receives email; it is only logged) ------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SupportDesk <no-reply@support.example.com>"

# --- behind a reverse proxy / load balancer ----------------------------------------------------
# Number of proxies in front of the app (1 for a single nginx/Traefik/ALB). Wrong values let
# clients spoof their IP and dodge rate limits; 0 = directly exposed.
TRUST_PROXY=1

# --- optional ----------------------------------------------------------------------------------
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
EXPORT_MAX_ROWS=20000
JOBS_ENABLED=true
LOG_LEVEL=info
EXPOSE_API_DOCS=false
FEATURE_DOMAIN_AUTOJOIN=false
# Serve the built web app from the API (set by the Docker image; use a path for bare-metal installs)
# CLIENT_DIST=/app/client/dist
# Set to false on all but one replica, and run migrations as a separate step
# RUN_MIGRATIONS=true
